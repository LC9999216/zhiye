# =====================================================================
# 知辨 (Zhibian) MVP — 环境变量示例
# ---------------------------------------------------------------------
# 使用方法：复制本文件为 `.env`（仓库根目录或 apps/api 目录均可），
# 按需修改。真实 `.env` 已被 .gitignore 忽略，不会被提交。
# 本文件只包含占位值与默认值，不包含任何真实密钥。
# =====================================================================

# ---- 应用模式 -------------------------------------------------------
# mock        : 无需真实知乎 / LLM / 数据库密钥即可启动并验收基础工程
# production  : 使用真实知乎 API 与 LLM 提供方
APP_MODE=mock

# ---- 数据库 ----------------------------------------------------------
# PostgreSQL 连接串（asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zhibian

# ---- 知乎开放平台 ----------------------------------------------------
# Access Secret（production 模式必填；只放入本机环境变量或未提交的 .env）
ZHIHU_ACCESS_SECRET=
# 知乎搜索 API 端点（受控配置，不接受用户输入）
ZHIHU_SEARCH_URL=https://developer.zhihu.com/api/v1/content/zhihu_search

# ---- LLM 提供方（OpenAI-compatible）---------------------------------
# production 模式必填；业务代码通过 Provider 接口隔离，不绑定单一厂商 SDK
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=45

# ---- Embedding 提供方（OpenAI-compatible）----------------------------
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding-vision-251215
EMBEDDING_DIMENSION=2048
EMBEDDING_TIMEOUT_SECONDS=20

# ---- 体验码与项目侧预算 ---------------------------------------------
# 只保存体验码 SHA-256，不保存明文；production 模式必填
INVITE_CODE_SHA256=
BUDGET_LIMIT_CNY=20
BUDGET_RESERVE_LIMIT_CNY=18
# 运行时会在搜索完成后按实际回答规模、摘要长度和以下保守上界计算单次预占；
# 若计算结果不能在 18 元预占额度内证明安全，任务会被拒绝。
# 旧版固定预占项，仅为兼容旧 .env 保留，不参与运行时计算。
BUDGET_RESERVATION_CNY=0
BUDGET_LLM_INPUT_CNY_PER_1K=0
BUDGET_LLM_OUTPUT_CNY_PER_1K=0
BUDGET_EMBEDDING_CNY_PER_1K=0
BUDGET_LLM_MAX_OUTPUT_TOKENS=4096
BUDGET_LLM_MAX_ATTEMPTS=3
BUDGET_EMBEDDING_MAX_TOKENS_PER_INPUT=4096
BUDGET_CONCEPT_MAX_TOKENS_PER_INPUT=256
BUDGET_MAX_CONCEPTS_PER_CLAIM=5
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SECONDS=900

# ---- 日志 ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- CORS ------------------------------------------------------------
# 允许的来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:3000

# ---- API 服务 --------------------------------------------------------
# 监听地址与端口
API_HOST=0.0.0.0
API_PORT=8000

# ---- Web 前端（apps/web）---------------------------------------------
# Next.js 前端访问后端 FastAPI 服务的基础地址（浏览器端使用，构建时内联）
NEXT_PUBLIC_API_URL=http://localhost:8000
